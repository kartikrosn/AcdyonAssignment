# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobpulse"

# Express server port
PORT=3001

# Source Board Tokens
GREENHOUSE_BOARD_TOKEN=stripe
LEVER_BOARD_TOKEN=spotify
ASHBY_BOARD_TOKEN=linear

# Outbound API Request Timeouts (ms)
GREENHOUSE_API_TIMEOUT_MS=10000
LEVER_API_TIMEOUT_MS=10000
ASHBY_API_TIMEOUT_MS=10000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Node environment: "development" | "production"
NODE_ENV=development

# CORS: origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
